# Copy this file to .env and fill in your own local values.
# Never commit the real .env file.

# Where the sqlite database file should live
DATABASE_PATH=data/billing.db

# Port the Flask app listens on
PORT=5000

# Stripe test mode keys, both start with test prefixes, never live keys
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRICE_ID_PRO=price_placeholder

# Where Stripe should send the customer back to after checkout
STRIPE_SUCCESS_URL=http://localhost:5000/checkout/success
STRIPE_CANCEL_URL=http://localhost:5000/checkout/cancel
